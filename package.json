{
  "name": "background-agents",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/index.mjs",
    "check": "node scripts/check.mjs",
    "jira:jql": "node --env-file-if-exists=.env scripts/jira-jql.mjs",
    "events:compact": "node --env-file-if-exists=.env scripts/compact-events.mjs",
    "microvm:build-image": "node --env-file-if-exists=.env scripts/microvm-build-image.mjs",
    "microvm:prepare": "node --env-file-if-exists=.env scripts/microvm-prepare.mjs",
    "postinstall": "node scripts/patch-agentos.mjs"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.9.1",
    "@hono/node-server": "^1.19.6",
    "@rivet-dev/agent-os-common": "^0.0.260331072558",
    "@rivet-dev/agent-os-core": "^0.1.1",
    "@rivet-dev/agent-os-pi": "^0.1.1",
    "hono": "^4.10.7",
    "playwright": "^1.56.1",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
