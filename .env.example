# Server
HOST=127.0.0.1
PORT=8787
AUTH_TOKEN=

# Agent runtime
AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Workspace
WORKSPACE_PATH=
WORKSPACE_READ_ONLY=false

# Concurrency
MAX_CONCURRENCY=10

# Max child agents one parent agent can start in a turn/session
AGENT_SPAWN_LIMIT=25

# Max AgentOS/Pi sessions that may bootstrap at once
AGENT_BOOT_CONCURRENCY=10
AGENT_BOOT_TIMEOUT_MS=45000
AGENT_BOOT_RETRIES=3
AGENT_AUTO_CONTINUE_LIMIT=0

# Jira
JIRA_BASE_URL=
JIRA_AUTH_MODE=
JIRA_CLOUD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SERVICE_ACCOUNT_EMAIL=
JIRA_SERVICE_ACCOUNT_TOKEN=
JIRA_AUTO_COMMENT=false
JIRA_TRIGGER_MENTION=@agent
JIRA_TRIGGER_STATUSES=
JIRA_TRIGGER_LABELS=

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_BASE=
GIT_ALLOW_PUSH=false
GITHUB_ALLOW_PR=false

# Browser
BROWSER_HEADLESS=true

# Gondolin MicroVM tools (vm_bash/vm_read/vm_write/vm_edit)
MICROVM_ENABLED=false
MICROVM_IMAGE_PATH=.data/microvm/node-browser-image
MICROVM_SNAPSHOT_PATH=.data/microvm/base-node-browser.qcow2
MICROVM_MEMORY=1536M
MICROVM_CPUS=2
MICROVM_MAX_ACTIVE=2
MICROVM_IDLE_MS=600000
MICROVM_START_TIMEOUT_MS=120000
MICROVM_ALLOWED_HOSTS=

# Figma integration
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_TEAM_ID=
FIGMA_OUTPUT_DIR=figma-assets

# Contentful inspection (read-only tools; hard-restricted to staging)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=staging
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
