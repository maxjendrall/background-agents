# Server
HOST=127.0.0.1
PORT=8787
AUTH_TOKEN=

# Agent runtime
AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Workspace
WORKSPACE_PATH=
WORKSPACE_READ_ONLY=false

# Concurrency
MAX_CONCURRENCY=10

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AUTO_COMMENT=false
JIRA_TRIGGER_MENTION=@agent
JIRA_TRIGGER_STATUSES=Ready for Dev,In Progress
JIRA_TRIGGER_LABELS=agent

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_BASE=main
GIT_ALLOW_PUSH=false
GITHUB_ALLOW_PR=false

# Browser
BROWSER_HEADLESS=true

# Figma integration
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_TEAM_ID=
FIGMA_OUTPUT_DIR=figma-assets

# Contentful inspection (read-only tools; hard-restricted to staging)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=staging
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
